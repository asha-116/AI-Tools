{
  "ci": {
    "collect": {
      "staticDistDir": "site/dist",
      "url": [
        "http://localhost/",
        "http://localhost/hi/",
        "http://localhost/tools/emi/",
        "http://localhost/hi/tools/emi/",
        "http://localhost/tools/commission/",
        "http://localhost/hi/tools/commission/",
        "http://localhost/tools/area/",
        "http://localhost/hi/tools/area/",
        "http://localhost/tools/stamp-duty/",
        "http://localhost/hi/tools/stamp-duty/",
        "http://localhost/get-download/",
        "http://localhost/hi/get-download/",
        "http://localhost/templates/lead-tracker/",
        "http://localhost/hi/templates/lead-tracker/",
        "http://localhost/templates/commission-ledger/",
        "http://localhost/hi/templates/commission-ledger/"
      ],
      "numberOfRuns": 3,
      "settings": {
        "chromeFlags": "--no-sandbox --headless=new",
        "onlyCategories": ["performance", "accessibility", "best-practices", "seo"]
      }
    },
    "assert": {
      "assertMatrix": [
        {
          "matchingUrlPattern": "^(?!.*(stamp-duty|get-download)).*$",
          "assertions": {
            "categories:performance": [
              "error",
              {
                "minScore": 0.9,
                "aggregationMethod": "median-run"
              }
            ],
            "categories:accessibility": [
              "error",
              {
                "minScore": 0.9,
                "aggregationMethod": "median-run"
              }
            ],
            "categories:best-practices": [
              "error",
              {
                "minScore": 0.9,
                "aggregationMethod": "median-run"
              }
            ],
            "categories:seo": [
              "error",
              {
                "minScore": 0.9,
                "aggregationMethod": "median-run"
              }
            ]
          }
        },
        {
          "matchingUrlPattern": ".*(stamp-duty|get-download).*",
          "assertions": {
            "categories:performance": [
              "error",
              {
                "minScore": 0.9,
                "aggregationMethod": "median-run"
              }
            ],
            "categories:accessibility": [
              "error",
              {
                "minScore": 0.9,
                "aggregationMethod": "median-run"
              }
            ],
            "categories:best-practices": [
              "error",
              {
                "minScore": 0.9,
                "aggregationMethod": "median-run"
              }
            ]
          }
        }
      ]
    },
    "upload": {
      "target": "filesystem",
      "outputDir": ".lighthouseci"
    }
  }
}
