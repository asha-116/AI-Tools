# ToolShop environment variables — PLACEHOLDER NAMES ONLY.
# Real values live in GitHub Actions Secrets or Cloudflare environment variables.
# Never put real values in this file or anywhere else in git. See docs/SETUP.md.

# --- Global ---
# true = agents do everything except external writes (no Issues/PRs/emails/API mutations).
DRY_RUN=true

# --- LLM providers (free tiers; see agents/lib/providers.json for fallback order) ---
GEMINI_API_KEY=
GROQ_API_KEY=
OPENROUTER_API_KEY=
CEREBRAS_API_KEY=
# Optional local model, e.g. http://localhost:11434/v1
OLLAMA_BASE_URL=

# --- GitHub (agents) ---
# In Actions, prefer the built-in GITHUB_TOKEN with least-privilege `permissions:`.
GITHUB_TOKEN=

# --- Cloudflare (deploy) ---
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ACCOUNT_ID=

# --- Razorpay ---
# Test-mode keys until the owner approves going live.
RAZORPAY_KEY_ID=
# Read-only usage by the Controller agent; secret usage by the webhook Worker.
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# --- File delivery ---
# HMAC key used to sign expiring download tokens (Worker only).
DOWNLOAD_SIGNING_KEY=

# --- Transactional email (provider TBD, owner approval required; see docs/COSTS.md) ---
EMAIL_API_KEY=
EMAIL_FROM=

# --- Support inbox (Phase 5) ---
SUPPORT_INBOX_TOKEN=
