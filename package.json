{
  "name": "toolshop",
  "version": "0.0.0",
  "private": true,
  "description": "ChangeLens — AI-agent-run digital tools business for Indian real-estate agents.",
  "license": "UNLICENSED",
  "type": "module",
  "engines": {
    "node": ">=22.13.0"
  },
  "workspaces": [
    "tools-core",
    "site"
  ],
  "scripts": {
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "check:structure": "node scripts/check-structure.mjs && node scripts/check-data-freshness.mjs",
    "build:templates": "node scripts/build-templates.mjs",
    "qa:bilingual": "vitest run agents/qa/test/bilingual.test.ts",
    "qa:pages": "vitest run agents/qa/test/pages.dist.test.ts",
    "build:agents": "tsc -p agents/tsconfig.json",
    "agent": "npm run build:agents && node agents/dist/agents/lib/bin/agent.js",
    "ci": "npm run lint && npm run format:check && npm run typecheck && npm run check:site && npm run test:coverage && npm run build:site && npm run qa:pages && npm run build:agents && npm run check:structure",
    "build:site": "npm run build -w @toolshop/site",
    "check:site": "npm run check -w @toolshop/site"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "22.20.5",
    "@vitest/coverage-v8": "5.0.5",
    "eslint": "10.13.0",
    "exceljs": "4.4.0",
    "globals": "17.13.0",
    "jszip": "3.10.2",
    "prettier": "3.9.10",
    "typescript": "7.0.2",
    "typescript-eslint": "8.72.1",
    "vitest": "5.0.5"
  },
  "dependencies": {
    "zod": "4.6.7"
  }
}
