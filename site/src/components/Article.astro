---
import { render, type CollectionEntry } from 'astro:content';
import { strings, type Lang } from '../i18n/strings';

interface Props {
  lang: Lang;
  entry: CollectionEntry<'articles'>;
}

const { lang, entry } = Astro.props;
const t = strings[lang];
const { Content } = await render(entry);
---

<article class="guide">
  <p class="crumb"><a href={lang === 'en' ? '/' : '/hi/'}>← {t.guidesBack}</a></p>
  <Content />
  <p class="cta">
    <a class="button" href={entry.data.tool_path}>{t.guidesOpenTool}</a>
  </p>
</article>

<style>
  .guide {
    max-width: 40rem;
    overflow-wrap: anywhere;
  }
  .crumb {
    margin: 16px 0 0;
  }
  .guide :global(h1) {
    font-size: clamp(1.75rem, 6vw, 2.25rem);
    line-height: 1.2;
    margin: 8px 0 16px;
  }
  .guide :global(h2) {
    font-size: 1.25rem;
    margin: 28px 0 8px;
  }
  .guide :global(h3) {
    font-size: 1.0625rem;
    margin: 20px 0 6px;
  }
  .guide :global(table) {
    width: 100%;
    border-collapse: collapse;
    margin: 8px 0;
  }
  .guide :global(th),
  .guide :global(td) {
    border-top: 1px solid var(--border);
    padding: 6px 4px;
    text-align: left;
    vertical-align: top;
  }
  .guide :global(td:last-child),
  .guide :global(th:last-child) {
    text-align: right;
    white-space: nowrap;
  }
  .guide :global(blockquote) {
    margin: 24px 0;
    padding: 12px 16px;
    border-left: 4px solid var(--brand);
    background: var(--card);
    border-radius: 0 var(--radius) var(--radius) 0;
  }
  .guide :global(blockquote p) {
    margin: 0;
    font-weight: 600;
  }
  .cta {
    margin: 24px 0;
  }
  .button {
    display: inline-block;
    min-height: 48px;
    padding: 12px 20px;
    border-radius: var(--radius);
    background: var(--brand);
    color: #fff;
    font-weight: 600;
    text-decoration: none;
  }
</style>
