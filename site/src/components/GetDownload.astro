---
import { config } from '../config';
import { claimStrings } from '../i18n/claim';
import type { Lang } from '../i18n/strings';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = claimStrings[lang];
const ready = config.claimUrl !== '' && config.downloadBaseUrl !== '';
const clientStrings = {
  submit: t.submit,
  sending: t.sending,
  linksNote: t.linksNote,
  errorPaymentId: t.errorPaymentId,
  errorEmail: t.errorEmail,
  errorNotFound: t.errorNotFound,
  errorNeedsSupport: t.errorNeedsSupport,
  errorRate: t.errorRate,
  errorGeneric: t.errorGeneric,
};
---

<article class="claim">
  <p class="crumb"><a href={lang === 'en' ? '/' : '/hi/'}>← {t.backHome}</a></p>
  <h1>{t.h1}</h1>
  {
    ready ? (
      <>
        <p class="lead">{t.lead}</p>
        <form
          id="claim-form"
          class="card"
          data-strings={JSON.stringify(clientStrings)}
          data-lang={lang}
          data-endpoint={config.claimUrl}
          data-download={config.downloadBaseUrl}
          novalidate
        >
          <div class="field">
            <label for="cl-payment">{t.paymentIdLabel}</label>
            <input
              id="cl-payment"
              name="payment_id"
              autocomplete="off"
              autocapitalize="off"
              spellcheck="false"
              placeholder="pay_…"
              aria-describedby="cl-payment-hint"
              required
            />
            <p class="hint" id="cl-payment-hint">
              {t.paymentIdHint}
            </p>
          </div>
          <div class="field">
            <label for="cl-email">{t.emailLabel}</label>
            <input id="cl-email" name="email" type="email" autocomplete="email" required />
          </div>
          <button type="submit" class="button">
            {t.submit}
          </button>
          <p class="status" role="status" aria-live="polite" />
        </form>
        <section id="claim-results" class="card" hidden>
          <h2>{t.linksTitle}</h2>
          <ul />
          <p class="hint" data-out="note" />
        </section>
      </>
    ) : (
      <p class="card">{t.notConfigured}</p>
    )
  }
  {
    config.supportEmail && (
      <p class="hint">
        {t.supportLine.split('{email}')[0]}
        <a href={`mailto:${config.supportEmail}`}>{config.supportEmail}</a>
        {t.supportLine.split('{email}')[1]}
      </p>
    )
  }
</article>

<script>
  import { initClaim } from '../scripts/claim';
  initClaim(document);
</script>

<style>
  .claim {
    max-width: 40rem;
  }
  .crumb {
    margin: 16px 0 0;
  }
  h1 {
    font-size: clamp(1.75rem, 6vw, 2.25rem);
    line-height: 1.2;
    margin: 8px 0;
  }
  h2 {
    font-size: 1.1875rem;
    margin: 0 0 8px;
  }
  .lead,
  .hint {
    color: var(--muted);
  }
  .hint {
    margin: 0;
    font-size: 0.9375rem;
  }
  .card {
    background: var(--card);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    padding: 16px;
    margin: 16px 0;
  }
  .field {
    display: grid;
    gap: 4px;
    margin-bottom: 12px;
  }
  input {
    min-height: 48px;
    padding: 10px 12px;
    font: inherit;
    border: 1px solid var(--border);
    border-radius: 8px;
    background: var(--bg);
    color: var(--fg);
    width: 100%;
  }
  .button {
    min-height: 48px;
    padding: 12px 20px;
    margin-top: 8px;
    border: 2px solid var(--brand);
    border-radius: var(--radius);
    background: var(--brand);
    color: var(--brand-fg);
    font: inherit;
    font-weight: 600;
    cursor: pointer;
  }
  .button[disabled] {
    opacity: 0.6;
    cursor: progress;
  }
  .status {
    margin: 12px 0 0;
    color: var(--error);
  }
  .status:empty {
    display: none;
  }
  #claim-results ul {
    padding-left: 1.25rem;
    margin: 0 0 8px;
  }
  #claim-results li {
    margin: 8px 0;
  }
  #claim-results a {
    font-weight: 600;
  }
</style>
