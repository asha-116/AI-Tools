---
import { strings, type Lang } from '../../i18n/strings';
import meta from './meta.json';
import { DEFAULT_STATE, evaluate, formatInr, formatSigned, type TransferField } from './logic';
import { transferStrings } from './strings';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = transferStrings[lang];
const common = strings[lang];
// Server-render the default result so the page is useful before (or without) JavaScript.
const initial = evaluate(DEFAULT_STATE);
const r = initial.ok ? initial.result : null;
const clientStrings = {
  share: t.share,
  shareCopied: t.shareCopied,
  months: t.months,
  breakEvenNever: t.breakEvenNever,
  breakEvenChanged: t.breakEvenChanged,
};

type Field = { name: TransferField; label: string; error: string; mode: string };
const nowFields: Field[] = [
  { name: 'outstanding', label: t.outstandingLabel, error: t.errorOutstanding, mode: 'numeric' },
  { name: 'currentRate', label: t.currentRateLabel, error: t.errorRate, mode: 'decimal' },
  { name: 'yearsLeft', label: t.yearsLeftLabel, error: t.errorYears, mode: 'decimal' },
];
const offerFields: Field[] = [
  { name: 'newRate', label: t.newRateLabel, error: t.errorRate, mode: 'decimal' },
  { name: 'newYears', label: t.newYearsLabel, error: t.errorYears, mode: 'decimal' },
  { name: 'switchingCosts', label: t.costsLabel, error: t.errorCosts, mode: 'numeric' },
];
const breakEven = (m: number | null) => (m === null ? t.breakEvenNever : `${String(m)} ${t.months}`);
const rows: Array<[string, string, string]> = r
  ? [
      [t.rowCurrentEmi, 'current-emi', formatInr(r.currentEmi)],
      [t.rowEmiDrop, 'emi-drop', formatSigned(r.emiDrop)],
      [t.rowInterestNow, 'interest-now', formatInr(r.currentInterestLeft)],
      [t.rowInterestNew, 'interest-new', formatInr(r.newInterest)],
      [t.rowInterestSaved, 'interest-saved', formatSigned(r.interestSaved)],
      [t.rowBreakEven, 'break-even', breakEven(r.breakEvenMonths)],
    ]
  : [];
---

<article class="tool">
  <p class="crumb"><a href={lang === 'en' ? '/' : '/hi/'}>← {t.backHome}</a></p>
  <h1>{t.h1}</h1>
  <p class="lead">{t.lead}</p>

  <form id="bt-form" class="card" data-strings={JSON.stringify(clientStrings)} novalidate>
    {
      [
        [t.nowLegend, nowFields],
        [t.offerLegend, offerFields],
      ].map(([legend, fields]) => (
        <fieldset>
          <legend>{legend as string}</legend>
          {(fields as Field[]).map((f) => (
            <div class="field">
              <label for={`bt-${f.name}`}>{f.label}</label>
              <input
                id={`bt-${f.name}`}
                name={f.name}
                inputmode={f.mode as 'numeric' | 'decimal'}
                autocomplete="off"
                value={DEFAULT_STATE[f.name]}
                aria-describedby={`bt-${f.name}-error`}
              />
              <p id={`bt-${f.name}-error`} class="error" data-error={f.name} hidden>
                {f.error}
              </p>
            </div>
          ))}
        </fieldset>
      ))
    }
  </form>

  <section class="card results" aria-live="polite">
    <p class="result-main">
      <span>{t.resultNet}</span>
      <strong data-out="net">{r ? formatSigned(r.netSaving) : '—'}</strong>
    </p>
    <p class="result-sub">
      <span>{t.resultNewEmi}</span>
      <strong data-out="new-emi">{r ? formatInr(r.newEmi) : '—'}</strong>
    </p>
    <dl>
      {
        rows.map(([label, key, value]) => (
          <div>
            <dt>{label}</dt>
            <dd data-out={key}>{value}</dd>
          </div>
        ))
      }
    </dl>
    <button type="button" class="button secondary" id="bt-share">{t.share}</button>
  </section>

  <section class="card">
    <h2>{t.formulaTitle}</h2>
    <p class="formula"><code>{meta.formula}</code></p>
    <p>{t.formulaWhere}</p>
    <h2>{t.assumptionsTitle}</h2>
    <ul>
      {t.assumptions.map((a) => <li>{a}</li>)}
    </ul>
    <p class="disclaimer"><strong>{common.toolDisclaimer}</strong></p>
  </section>
</article>

<script>
  import { initBalanceTransfer } from './client';
  initBalanceTransfer(document, window);
</script>

<style>
  .tool {
    max-width: 40rem;
  }
  .crumb {
    margin: 16px 0 0;
  }
  h1 {
    font-size: clamp(1.75rem, 6vw, 2.25rem);
    line-height: 1.2;
    margin: 8px 0;
  }
  h2 {
    font-size: 1.1875rem;
    margin: 0 0 8px;
  }
  .lead {
    color: var(--muted);
  }
  .card {
    background: var(--card);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    padding: 16px;
    margin: 16px 0;
  }
  .card h2 + p,
  .card ul {
    margin-top: 0;
  }
  fieldset {
    border: 0;
    margin: 0 0 8px;
    padding: 0;
    min-width: 0;
  }
  legend {
    font-weight: 600;
    margin-bottom: 8px;
  }
  .field {
    display: grid;
    gap: 4px;
    margin-bottom: 12px;
  }
  input {
    min-height: 48px;
    padding: 10px 12px;
    font: inherit;
    border: 1px solid var(--border);
    border-radius: 8px;
    background: var(--bg);
    color: var(--fg);
    width: 100%;
    min-width: 0;
  }
  input[aria-invalid='true'] {
    border-color: var(--error);
    border-width: 2px;
  }
  .error {
    color: var(--error);
    margin: 0;
    font-size: 0.9375rem;
  }
  .result-main,
  .result-sub {
    display: flex;
    flex-direction: column;
    margin: 0 0 12px;
  }
  .result-main strong {
    font-size: clamp(2rem, 9vw, 2.75rem);
    line-height: 1.1;
    color: var(--brand);
  }
  .result-sub strong {
    font-size: 1.375rem;
  }
  dl {
    display: grid;
    gap: 6px;
    margin: 0 0 12px;
  }
  dl div {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 4px 12px;
    border-top: 1px solid var(--border);
    padding-top: 6px;
  }
  dt {
    flex: 1 1 9rem;
  }
  dd {
    margin: 0 0 0 auto;
    font-weight: 600;
    text-align: right;
    white-space: nowrap;
  }
  .formula code {
    font-size: 1.0625rem;
    overflow-wrap: anywhere;
  }
  .button {
    min-height: 48px;
    padding: 12px 20px;
    border: 2px solid var(--brand);
    border-radius: var(--radius);
    background: transparent;
    color: var(--brand);
    font: inherit;
    font-weight: 600;
    cursor: pointer;
  }
  .disclaimer {
    margin-bottom: 0;
  }
</style>
