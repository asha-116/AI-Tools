{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "toolshop/data/stamp-duty/state.schema.json",
  "title": "Stamp duty and registration charges for one Indian state/UT",
  "description": "One file per state: data/stamp-duty/<state_code>.json (e.g. MH.json). Rates are data, never hard-coded in logic. Every rate must trace to an official source.",
  "type": "object",
  "required": ["state", "state_code", "sources", "last_verified", "verified_by", "rates"],
  "additionalProperties": false,
  "properties": {
    "state": { "type": "string", "description": "Official English name, e.g. Maharashtra" },
    "state_name_hi": { "type": "string", "description": "Hindi name, e.g. महाराष्ट्र" },
    "state_code": {
      "type": "string",
      "pattern": "^[A-Z]{2}$",
      "description": "Two-letter code as used on vehicle registration / GST state list, e.g. MH"
    },
    "sources": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["url", "title", "accessed"],
        "additionalProperties": false,
        "properties": {
          "url": { "type": "string", "pattern": "^https://" },
          "title": { "type": "string" },
          "accessed": { "type": "string", "format": "date" }
        }
      }
    },
    "last_verified": { "type": "string", "format": "date" },
    "verified_by": {
      "type": "string",
      "description": "Who checked the numbers against the source: 'owner', or an agent name plus the verifier model family"
    },
    "notes": { "type": "string" },
    "rates": {
      "type": "array",
      "minItems": 1,
      "description": "Ordered rules; the first rule whose conditions all match is applied.",
      "items": {
        "type": "object",
        "required": ["id", "description", "stamp_duty_percent", "registration"],
        "additionalProperties": false,
        "properties": {
          "id": { "type": "string" },
          "description": { "type": "string" },
          "conditions": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "area": {
                "type": "string",
                "description": "e.g. 'urban', 'rural', or a named municipal area"
              },
              "buyer_gender": { "enum": ["male", "female", "joint", "any"] },
              "property_type": { "enum": ["residential", "commercial", "land", "any"] },
              "min_value_inr": { "type": "number", "minimum": 0 },
              "max_value_inr": { "type": "number", "minimum": 0 }
            }
          },
          "stamp_duty_percent": { "type": "number", "minimum": 0, "maximum": 100 },
          "surcharges_percent": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["name", "percent"],
              "properties": {
                "name": { "type": "string", "description": "e.g. metro cess, local body tax" },
                "percent": { "type": "number", "minimum": 0, "maximum": 100 }
              }
            }
          },
          "registration": {
            "type": "object",
            "required": ["percent"],
            "additionalProperties": false,
            "properties": {
              "percent": { "type": "number", "minimum": 0, "maximum": 100 },
              "cap_inr": { "type": ["number", "null"], "minimum": 0 },
              "min_inr": { "type": ["number", "null"], "minimum": 0 }
            }
          }
        }
      }
    }
  }
}
