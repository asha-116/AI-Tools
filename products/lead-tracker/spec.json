        "bySource": { "whatsapp": 3, "referral": 1, "portal": 2, "walk-in": 1 }
      }
    },
    "call_list": {
      "rows": [
        { "name": "A", "status": "new", "next": "2026-10-05" },
        { "name": "B", "status": "contacted", "next": "2026-10-01" },
        { "name": "C", "status": "won", "next": "2026-09-30" },
        { "name": "D", "status": "visit-planned", "next": "2026-10-09" },
        { "name": "E", "status": "negotiating", "next": "2026-10-03" },
        { "name": "F", "status": "new", "next": null }
      ],
      "expect": ["B", "E", "A"]
    }
  }
}
